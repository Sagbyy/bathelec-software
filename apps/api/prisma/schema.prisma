generator client {
  provider = "prisma-client-js"
}

datasource db_postgres {
  provider = "postgresql"
  url      = env("DATABASE_POSTGRES_URL")
}

model User {
  id                         Int                         @id @default(autoincrement())
  email                      String                      @unique
  username                   String                      @unique
  password                   String
  role                       String
  createdAt                  DateTime                    @default(now())
  firstName                  String
  lastName                   String
  Derivation                 Derivation[]
  teamMemberships            SiteTeamMembership[]
  expiryNotifications        ExpiryNotification[]
  expiryNotificationReceipts ExpiryNotificationReceipt[]
}

model Market {
  id        Int        @id @default(autoincrement())
  name      String     @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  chantiers Chantier[]
}

model Chantier {
  id                    Int          @id @default(autoincrement())
  address               String
  enedisAffaireNumber   String
  internalAffaireNumber String
  marketId              Int
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
  market                Market       @relation(fields: [marketId], references: [id])
  derivations           Derivation[]
}

model Derivation {
  id                Int       @id @default(autoincrement())
  userId            Int?
  chantierId        Int?
  createdAt         DateTime  @default(now())
  status            String
  correctionComment String?
  teamId            Int?
  user              User?     @relation(fields: [userId], references: [id], onDelete: Restrict)
  chantier          Chantier? @relation(fields: [chantierId], references: [id])
  team              SiteTeam? @relation(fields: [teamId], references: [id], onDelete: SetNull)

  @@index([teamId])
}

model SiteTeam {
  id              Int                  @id @default(autoincrement())
  name            String               @unique
  description     String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  teamMemberships SiteTeamMembership[]
  derivations     Derivation[]

  @@map("UserGroup")
}

model SiteTeamMembership {
  id        Int      @id @default(autoincrement())
  userId    Int
  teamId    Int      @map("groupId")
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  team      SiteTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([userId, teamId])
  @@index([userId])
  @@index([teamId])
  @@map("UserGroupMembership")
}

model ExpiryNotification {
  id            Int                         @id @default(autoincrement())
  technicianId  Int
  documentKey   String
  documentLabel String
  expiresAt     DateTime
  threshold     Int
  createdAt     DateTime                    @default(now())
  technician    User                        @relation(fields: [technicianId], references: [id], onDelete: Cascade)
  receipts      ExpiryNotificationReceipt[]

  @@unique([technicianId, documentKey, expiresAt, threshold], map: "ExpiryNotification_document_threshold_key")
  @@index([technicianId])
}

model ExpiryNotificationReceipt {
  notificationId Int
  userId         Int
  acknowledgedAt DateTime           @default(now())
  notification   ExpiryNotification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([notificationId, userId])
}
