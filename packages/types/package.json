{
  "name": "@repo/types",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "./dist/**"
  ],
  "typesVersions": {
    "*": {
      "*": [
        "src/*"
      ]
    }
  },
  "exports": {
    ".": {
      "require": "./dist/index.js",
      "import": "./dist/index.js"
    },
    "./technician": {
      "require": "./dist/technician.js",
      "import": "./dist/technician.js"
    },
    "./user": {
      "require": "./dist/user.js",
      "import": "./dist/user.js"
    },
    "./derivation": {
      "require": "./dist/derivation.js",
      "import": "./dist/derivation.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist node_modules",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "pnpm lint --fix",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@repo/typescript-config": "workspace:*",
    "typescript": "^5.7.3"
  }
}
